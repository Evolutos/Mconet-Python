{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object"
        },
        "id": {
          "$ref": "#/$defs/nonWhitespaceString"
        },
        "kind": {
          "$ref": "#/$defs/artifactKind"
        },
        "mediaType": {
          "oneOf": [
            {
              "$ref": "#/$defs/mediaType"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/artifactSource"
        }
      },
      "required": [
        "id",
        "kind",
        "source"
      ],
      "type": "object"
    },
    "artifactDescriptor": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/openIdentifier"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "artifactKind": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "type": "object"
        },
        "id": {
          "$ref": "#/$defs/openIdentifier"
        },
        "semantic": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "artifactSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/inlineSource"
        },
        {
          "$ref": "#/$defs/uriSource"
        },
        {
          "$ref": "#/$defs/localFileSource"
        },
        {
          "$ref": "#/$defs/openSource"
        }
      ]
    },
    "inlineSource": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "pattern": "^(?:[0-9a-f]{2})*$",
          "type": "string"
        },
        "kind": {
          "const": "artifact.inline"
        }
      },
      "required": [
        "bytes",
        "kind"
      ],
      "type": "object"
    },
    "localFileSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact.local_file"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "type": "object"
    },
    "mediaType": {
      "pattern": "^[ \\t]*[!#$%&'*+.^_`|~0-9A-Za-z-]+/[!#$%&'*+.^_`|~0-9A-Za-z-]+(?:[ \\t]*;[ \\t]*[!#$%&'*+.^_`|~0-9A-Za-z-]+=(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+|\"(?:[\\t !#-\\[\\]-~\\u0080-\\u00FF]|\\\\[\\t !-~\\u0080-\\u00FF])*\")[ \\t]*)*[ \\t]*$",
      "type": "string"
    },
    "nonWhitespaceString": {
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "type": "string"
    },
    "openIdentifier": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$",
      "type": "string"
    },
    "openSource": {
      "additionalProperties": true,
      "properties": {
        "extensions": {
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/openIdentifier",
          "not": {
            "enum": [
              "artifact.inline",
              "artifact.local_file",
              "artifact.uri"
            ]
          }
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "uriSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact.uri"
        },
        "uri": {
          "additionalProperties": false,
          "properties": {
            "isAbsolute": {
              "type": "boolean"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "isAbsolute",
            "value"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "type": "object"
    }
  },
  "$id": "schema.artifact_catalog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "type": "array"
    }
  },
  "required": [
    "artifacts"
  ],
  "type": "object"
}
