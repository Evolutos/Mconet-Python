{
  "$id": "schema.model_target",
  "additionalProperties": false,
  "properties": {
    "deploymentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "type": "object"
        },
        "family": {
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$",
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "name": {
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "protocolId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$",
      "type": "string"
    },
    "serviceId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)*$",
      "type": "string"
    }
  },
  "required": [
    "model",
    "protocolId",
    "serviceId"
  ],
  "type": "object"
}
