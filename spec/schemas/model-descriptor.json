      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "type": "string"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ],
  "type": "object"
