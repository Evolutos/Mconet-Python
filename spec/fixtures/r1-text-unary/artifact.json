        "extensions": {
          "vendor.trace": {
            "enabled": true
          }
        },
        "id": "depth-map",
        "kind": {
          "extensions": {
            "vendor.version": 2
          },
          "id": "vendor.depth_map",
          "semantic": "Depth values aligned to an image plane."
        },
        "mediaType": "application/vnd.vendor.depth+binary; version=2",
        "metadata": {
          "height": 480,
          "width": 640
        },
        "source": {
          "bytes": "01020304",
          "kind": "artifact.inline"
        }
      },
      "input": {
        "extensions": {
          "vendor.trace": {
            "enabled": true
          }
        },
        "id": "depth-map",
        "kind": {
          "extensions": {
            "vendor.version": 2
          },
          "id": "vendor.depth_map",
          "semantic": "Depth values aligned to an image plane."
        },
        "mediaType": "application/vnd.vendor.depth+binary; version=2",
        "metadata": {
          "height": 480,
          "width": 640
        },
        "source": {
          "bytes": "01020304",
          "kind": "artifact.inline"
        }
      },
      "name": "provider-defined-kind-round-trip"
    }
  ]
}
